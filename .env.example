# Gmail SMTP — use guricbusiness@gmail.com with a Google App Password
# Create one: Google Account → Security → 2-Step Verification → App passwords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=guricbusiness@gmail.com
SMTP_PASS=your-16-char-app-password

# Where enquiry emails are delivered (defaults to guricbusiness@gmail.com)
CONTACT_TO_EMAIL=guricbusiness@gmail.com
