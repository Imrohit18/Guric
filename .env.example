# Option A — Gmail SMTP (recommended if you use guricbusiness@gmail.com)
# Create an App Password: Google Account → Security → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=guricbusiness@gmail.com
SMTP_PASS=your-16-char-app-password
CONTACT_TO_EMAIL=guricbusiness@gmail.com

# Option B — Web3Forms (easier on Vercel: free at https://web3forms.com)
# WEB3FORMS_ACCESS_KEY=your-access-key
